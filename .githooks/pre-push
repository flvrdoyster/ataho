#!/usr/bin/env bash

if [ -n "$SKIP_GA4_CHECK" ]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 0

command -v python3 >/dev/null 2>&1 || exit 0

ZERO="0000000000000000000000000000000000000000"
TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TMPDIR"' EXIT

blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  [ "$remote_sha" = "$ZERO" ] && continue

  for name in ga4 blog; do
    path="dashboard/data/${name}.js"
    git show "${local_sha}:${path}" >"$TMPDIR/local_${name}.js" 2>/dev/null
    git show "${remote_sha}:${path}" >"$TMPDIR/remote_${name}.js" 2>/dev/null
    git show "${local_sha}:dashboard/archive/${name}.json" >"$TMPDIR/local_${name}.archive.json" 2>/dev/null
    git show "${remote_sha}:dashboard/archive/${name}.json" >"$TMPDIR/remote_${name}.archive.json" 2>/dev/null
  done

  python3 - "$TMPDIR" <<'PYEOF'
import json
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

tmp = Path(sys.argv[1])

TREND_DAYS = 28
KST = timezone(timedelta(hours=9))
cutoff = (datetime.now(KST).date() - timedelta(days=TREND_DAYS)).isoformat()

def load(path):
    if not path.exists() or path.stat().st_size == 0:
        return None
    try:
        text = path.read_text(encoding="utf-8")
        body = text.split("=", 2)[2].strip().rstrip(";")
        return json.loads(body)
    except Exception:
        return None

blocked = False
for name in ("ga4", "blog"):
    local, remote = load(tmp / f"local_{name}.js"), load(tmp / f"remote_{name}.js")
    if local is None or remote is None:
        continue

    gap = sorted(d for d in (set(remote.get("history", {}))
                             - set(local.get("history", {}))) if d >= cutoff)
    if gap:
        blocked = True
        print(f"   {name}.js: origin에는 있는데 로컬엔 없는 날짜 — {', '.join(gap)}")

    lo = (local.get("yesterday") or {}).get("date")
    ro = (remote.get("yesterday") or {}).get("date")
    if lo and ro and lo < ro:
        blocked = True
        print(f"   {name}.js: 기준 날짜가 뒤로 감 — origin {ro} → 로컬 {lo}")

    la, ra = tmp / f"local_{name}.archive.json", tmp / f"remote_{name}.archive.json"
    try:
        lost = sorted(set(json.loads(ra.read_text(encoding="utf-8")))
                      - set(json.loads(la.read_text(encoding="utf-8"))))
    except Exception:
        lost = []
    if lost:
        blocked = True
        print(f"   archive/{name}.json: origin에는 있는데 로컬엔 없는 날짜 — {lost[0]} 외 {len(lost) - 1}일")

sys.exit(1 if blocked else 0)
PYEOF
  if [ $? -ne 0 ]; then
    blocked=1
  fi
done

if [ "$blocked" -eq 1 ]; then
  echo "⚠️  로컬의 dashboard/data history가 origin보다 뒤처졌습니다 (push를 막습니다)."
  echo "   먼저 origin을 반영한 뒤 다시 시도하세요:"
  echo "     git fetch origin && git merge origin/main"
  echo "   급하면 이번만 건너뛰기: SKIP_GA4_CHECK=1 git push"
  exit 1
fi

exit 0
